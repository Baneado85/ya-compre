<section class="product-faq-section" style="padding: 4.5rem 0; background: {{ section.settings.bg_color | default: '#fcf8f3' }};">
  <div class="container">

    <div style="text-align: center; max-width: 700px; margin: 0 auto 3rem;">
      {% if section.settings.tag != blank %}
        <span style="display: inline-block; background: #f3e8ff; color: #7e22ce; font-weight: 800; font-size: 0.8rem; padding: 0.35rem 0.85rem; border-radius: 20px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.75rem;">
          {{ section.settings.tag }}
        </span>
      {% endif %}
      <h2 style="font-family: var(--font-heading, sans-serif); font-size: clamp(1.75rem, 4vw, 2.4rem); font-weight: 800; color: #0f172a; margin: 0 0 0.75rem;">
        {{ section.settings.title | default: "Preguntas Frecuentes" }}
      </h2>
      {% if section.settings.subtitle != blank %}
        <p style="font-size: 1rem; color: #64748b; margin: 0;">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}
    </div>

    <div class="faq-accordion-list" style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem;">
      {% for block in section.blocks %}
        <div 
          class="faq-accordion-item {% if forloop.first %}active{% endif %}" 
          {{ block.shopify_attributes }}
          style="border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #ffffff; transition: border-color 0.2s ease;"
        >
          <button 
            type="button" 
            class="faq-header-btn" 
            onclick="toggleProductFAQ(this)"
            style="width: 100%; padding: 1.25rem 1.5rem; background: transparent; border: none; text-align: left; font-family: var(--font-heading, sans-serif); font-weight: 700; font-size: 1.05rem; color: #0f172a; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem;"
          >
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon" style="font-size: 1.25rem; font-weight: 400; transition: transform 0.3s ease; color: #64748b;">
              {% if forloop.first %}−{% else %}+{% endif %}
            </span>
          </button>

          <div 
            class="faq-body-content" 
            style="padding: {% if forloop.first %}0 1.5rem 1.25rem{% else %}0 1.5rem{% endif %}; max-height: {% if forloop.first %}500px{% else %}0{% endif %}; overflow: hidden; transition: all 0.3s ease; font-size: 0.95rem; color: #475569; line-height: 1.6;"
          >
            {{ block.settings.answer }}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

<script>
  function toggleProductFAQ(btn) {
    const item = btn.parentElement;
    const content = item.querySelector('.faq-body-content');
    const icon = item.querySelector('.faq-icon');
    const isOpen = item.classList.contains('active');

    // Close all items
    document.querySelectorAll('.faq-accordion-item').forEach(el => {
      el.classList.remove('active');
      const c = el.querySelector('.faq-body-content');
      const ic = el.querySelector('.faq-icon');
      if (c) {
        c.style.maxHeight = '0px';
        c.style.paddingBottom = '0px';
      }
      if (ic) ic.textContent = '+';
    });

    // If was closed, open it
    if (!isOpen) {
      item.classList.add('active');
      content.style.maxHeight = '500px';
      content.style.paddingBottom = '1.25rem';
      icon.textContent = '−';
    }
  }
</script>

{% schema %}
{
  "name": "Preguntas Frecuentes",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo de sección",
      "default": "#fcf8f3"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Etiqueta superior",
      "default": "DESPEJA TUS DUDAS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título de la sección",
      "default": "Preguntas Frecuentes sobre tu Pedido"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo de la sección",
      "default": "Todo lo que necesitas saber antes de realizar tu compra con Pago Contra Entrega."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta / Respuesta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Cómo funciona el Pago Contra Entrega (COD)?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Respuesta",
          "default": "Es 100% seguro. Realizas tu pedido completando tus datos en el formulario. Nosotros preparamos tu paquete y te lo enviamos a tu domicilio. Le pagas directamente al repartidor en efectivo, Yape, Plin o tarjeta al recibirlo en tu puerta."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Preguntas Frecuentes",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "¿Cómo funciona el Pago Contra Entrega?",
            "answer": "Es 100% seguro. Realizas tu pedido en la web llenando tu dirección. Nosotros preparamos tu pedido y te lo enviamos. Le pagas al repartidor en efectivo, Yape o Plin una vez que recibas y tengas el paquete en tus manos."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Cuánto demoran en entregar mi pedido?",
            "answer": "Para Lima y Callao los pedidos se entregan en 24 a 48 horas hábiles. Para provincias el envío toma entre 2 a 4 días hábiles mediante agencias autorizadas como Olva Courier o Shalom con número de seguimiento."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Tiene costo el envío?",
            "answer": "¡No! El envío es totalmente GRATIS a todo el Perú en esta promoción por tiempo limitado."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "¿Qué garantía tiene el producto?",
            "answer": "Contamos con una garantía de satisfacción de 30 días directos. Si tu producto presenta cualquier defecto de fábrica o disconformidad, te realizamos un cambio inmediato o reembolso."
          }
        }
      ]
    }
  ]
}
{% endschema %}
