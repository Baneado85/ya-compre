<script>
  function adjustQtyVal(delta) {
    const input = document.getElementById('selected-product-qty');
    if (!input) return;
    const current = parseInt(input.value, 10) || 1;
    const next = Math.max(1, current + delta);
    input.value = next;
  }

  function onQtyInputChange(val) {
    const input = document.getElementById('selected-product-qty');
    if (!input) return;
    const current = parseInt(val, 10) || 1;
    input.value = Math.max(1, current);
  }

  function switchProductGalleryThumb(thumbEl, newSrc) {
    const mainImg = document.getElementById('main-product-media-img');
    if (mainImg) {
      mainImg.src = newSrc;
    }
    document.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('active'));
    if (thumbEl) {
      thumbEl.classList.add('active');
    }
  }

  /* Auto-Rotating Payment & Shipping Visor Script */
  (function initPaymentRotator() {
    const items = [
      { name: 'Yape', index: 0 },
      { name: 'Plin', index: 1 },
      { name: 'Visa', index: 2 },
      { name: 'Mastercard', index: 3 },
      { name: 'Olva Courier', index: 4 },
      { name: 'Shalom Express', index: 5 }
    ];

    let currentIndex = 0;
    let intervalId = null;
    let pauseTimeout = null;

    function setRotatorIndex(index) {
      currentIndex = index;
      const nameEl = document.getElementById('payment-active-name');
      if (nameEl) {
        nameEl.textContent = items[index].name;
      }
      const badgeElements = document.querySelectorAll('.payment-icon-item');
      badgeElements.forEach((el, idx) => {
        if (idx === index) {
          el.classList.add('active');
        } else {
          el.classList.remove('active');
        }
      });
    }

    function startAutoRotation() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        currentIndex = (currentIndex + 1) % items.length;
        setRotatorIndex(currentIndex);
      }, 2200);
    }

    window.setActivePaymentBadge = function(element, name, index) {
      if (intervalId) clearInterval(intervalId);
      if (pauseTimeout) clearTimeout(pauseTimeout);
      setRotatorIndex(index);
      // Resume auto rotation after 4 seconds
      pauseTimeout = setTimeout(startAutoRotation, 4000);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setRotatorIndex(0);
        startAutoRotation();
      });
    } else {
      setRotatorIndex(0);
      startAutoRotation();
    }
  })();
</script>

