<section class="main-product-section" id="main-product-section" style="padding: 2rem 0 3rem;">
  <div class="container">

    {% if section.settings.show_urgency_bar %}
      <!-- Urgency & Countdown Announcement Bar -->
      <div class="urgency-banner" style="background: {{ section.settings.urgency_bg_color | default: 'linear-gradient(90deg, #e63946 0%, #d62828 100%)' }}; color: {{ section.settings.urgency_text_color | default: '#ffffff' }}; padding: 0.75rem 1.25rem; border-radius: var(--radius-md, 8px); margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; box-shadow: 0 4px 15px rgba(230,57,70,0.25);">
        <div class="urgency-text" style="font-weight: 700; font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-size: 1.2rem; animation: pulse 1.5s infinite;">⚡</span>
          <span>{{ section.settings.urgency_text | default: "¡OFERTA ESPECIAL POR TIEMPO LIMITADO!" }}</span>
        </div>
        <div class="urgency-timer" style="display: flex; align-items: center; gap: 0.4rem; font-weight: 800; font-family: monospace; font-size: 1.1rem; background: rgba(0,0,0,0.2); padding: 0.35rem 0.75rem; border-radius: 6px;">
          <span id="pdp-countdown-hours">00</span>:
          <span id="pdp-countdown-mins">14</span>:
          <span id="pdp-countdown-secs">59</span>
        </div>
      </div>
    {% endif %}

    <div class="product-detail-grid" style="display: grid; grid-template-columns: 1fr; gap: 2.5rem;">
      
      <!-- Media Gallery -->
      <div class="product-gallery" style="position: relative;">
        <div class="main-image-wrapper" style="position: relative; border-radius: var(--radius-lg, 12px); overflow: hidden; background: #fff; border: 1px solid rgba(0,0,0,0.06); box-shadow: 0 8px 30px rgba(0,0,0,0.05);">
          {% if section.settings.show_discount_badge %}
            <div class="gallery-badge" style="position: absolute; top: 1rem; left: 1rem; z-index: 2; background: #e63946; color: #fff; font-weight: 800; font-size: 0.85rem; padding: 0.4rem 0.85rem; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 0 4px 10px rgba(230,57,70,0.4);">
              {{ section.settings.discount_badge_text | default: "🔥 HASTA -30% OFF" }}
            </div>
          {% endif %}
          
          <div class="cod-badge" style="position: absolute; top: 1rem; right: 1rem; z-index: 2; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); color: #ffd166; font-weight: 700; font-size: 0.75rem; padding: 0.4rem 0.85rem; border-radius: 20px; display: flex; align-items: center; gap: 0.35rem; border: 1px solid rgba(255,209,102,0.3);">
            <span>🚚</span> PAGO CONTRA ENTREGA
          </div>

          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" class="main-product-img" id="main-product-media-img" style="width: 100%; height: auto; display: block; object-fit: cover; transition: transform 0.3s ease;">
          {% else %}
            <img src="{{ 'magnesio_complex.png' | asset_url }}" alt="BIOTINA MAX + COLÁGENO" class="main-product-img" id="main-product-media-img" style="width: 100%; height: auto; display: block; object-fit: cover;">
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="gallery-thumbs" style="display: flex; gap: 0.75rem; margin-top: 1rem; overflow-x: auto; padding-bottom: 0.5rem;">
            {% for image in product.images %}
              <img 
                src="{{ image | image_url: width: 250 }}" 
                alt="{{ product.title | escape }}" 
                class="thumb-item {% if forloop.first %}active{% endif %}" 
                style="width: 75px; height: 75px; object-fit: cover; border-radius: 8px; cursor: pointer; border: 2px solid {% if forloop.first %}var(--color-button, #121212){% else %}transparent{% endif %}; opacity: {% if forloop.first %}1{% else %}0.7{% endif %}; transition: all 0.2s ease;"
                onclick="switchProductGalleryThumb(this, '{{ image | image_url: width: 1000 }}')"
              >
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Information -->
      <div class="product-detail-info" style="display: flex; flex-direction: column;">
        
        {% if section.settings.show_vendor and product.vendor != blank %}
          <span class="product-vendor" style="text-transform: uppercase; font-size: 0.8rem; font-weight: 700; letter-spacing: 1.5px; color: var(--text-secondary, #666); margin-bottom: 0.25rem;">
            {{ product.vendor }}
          </span>
        {% endif %}

        <h1 style="font-family: var(--font-heading, sans-serif); font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 800; line-height: 1.25; margin: 0 0 0.75rem; color: var(--color-foreground, #111);">
          {{ product.title | default: "BIOTINA MAX + COLÁGENO - FÓRMULA PREMIUM" }}
        </h1>

        <!-- Rating Summary -->
        {% if section.settings.show_rating %}
          <div class="product-rating-summary" style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
            <div style="color: #ffb703; font-size: 1.1rem; letter-spacing: 1px;">★★★★★</div>
            <span style="font-weight: 700; font-size: 0.9rem; color: #111;">4.9/5.0</span>
            <a href="#product-reviews-section" style="font-size: 0.85rem; color: var(--text-secondary, #666); text-decoration: underline; cursor: pointer;">
              ({{ section.settings.rating_count | default: "142 opiniones verificadas" }})
            </a>
          </div>
        {% endif %}

        <!-- Stock Progress Bar -->
        {% if section.settings.show_stock_bar %}
          <div class="stock-progress-box" style="background: #fff0f3; border: 1px solid #ffccd5; border-radius: 8px; padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
            <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 700; color: #c9184a; margin-bottom: 0.4rem;">
              <span>🔥 {{ section.settings.stock_text | default: "¡ALERTA DE STOCK BAJO!" }}</span>
              <span id="stock-count-val">{{ section.settings.initial_stock | default: 10 }} unidades restantes</span>
            </div>
            <div style="width: 100%; height: 8px; background: #ffb3c1; border-radius: 10px; overflow: hidden;">
              <div id="stock-progress-bar" style="width: 85%; height: 100%; background: linear-gradient(90deg, #ff4d6d, #c9184a); border-radius: 10px; transition: width 0.5s ease;"></div>
            </div>
          </div>
        {% endif %}

        <!-- Price Section -->
        <div class="product-price-container" style="display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(0,0,0,0.08);">
          <span class="price-current" id="main-price-display" style="font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 900; color: #0f172a; font-family: var(--font-heading, sans-serif);">
            {% if product.price != blank and product.price > 0 %}
              {{ product.selected_or_first_available_variant.price | money }}
            {% else %}
              S/. 139.90
            {% endif %}
          </span>

          {% if product.compare_at_price > product.price %}
            <span class="price-original" id="main-compare-price-display" style="font-size: 1.25rem; text-decoration: line-through; color: #94a3b8; font-weight: 500;">
              {{ product.compare_at_price | money }}
            </span>
          {% else %}
            <span class="price-original" id="main-compare-price-display" style="font-size: 1.25rem; text-decoration: line-through; color: #94a3b8; font-weight: 500;">
              S/. 199.90
            </span>
          {% endif %}

          <span class="shipping-tag" style="background: #e0f2fe; color: #0284c7; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 4px; display: flex; align-items: center; gap: 0.25rem;">
            <span>🚚</span> ENVÍO GRATIS
          </span>
        </div>

        <!-- Clean Standard Quantity Selector (Sube / Baja Cantidad sin ofertas arbitrarias) -->
        <div class="quantity-selector-container" style="margin-bottom: 1.5rem;">
          <label style="font-weight: 700; font-size: 0.9rem; color: #334155; display: block; margin-bottom: 0.5rem;">
            Cantidad:
          </label>
          <div style="display: flex; align-items: center; gap: 0.5rem; max-width: 140px;">
            <button 
              type="button" 
              onclick="adjustQtyVal(-1)" 
              style="width: 40px; height: 42px; border-radius: 8px; border: 1px solid #cbd5e1; background: #f8fafc; font-size: 1.2rem; font-weight: 700; cursor: pointer;"
            >−</button>
            <input 
              type="number" 
              id="selected-product-qty" 
              name="quantity" 
              value="1" 
              min="1" 
              onchange="onQtyInputChange(this.value)"
              style="width: 50px; height: 42px; text-align: center; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 1rem; font-weight: 700; outline: none;"
            >
            <button 
              type="button" 
              onclick="adjustQtyVal(1)" 
              style="width: 40px; height: 42px; border-radius: 8px; border: 1px solid #cbd5e1; background: #f8fafc; font-size: 1.2rem; font-weight: 700; cursor: pointer;"
            >+</button>
          </div>
        </div>

        <!-- Variants Selector (if product has options) -->
        {% unless product.has_only_default_variant %}
          <div class="product-variant-selector-wrapper" style="margin-bottom: 1.5rem;">
            {% for option in product.options_with_values %}
              <div style="margin-bottom: 1rem;">
                <label style="font-weight: 700; font-size: 0.9rem; color: #334155; display: block; margin-bottom: 0.4rem;">
                  {{ option.name }}: <span style="font-weight: 400;" id="option-val-label-{{ option.position }}">{{ option.selected_value }}</span>
                </label>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                  {% for value in option.values %}
                    <button 
                      type="button" 
                      class="variant-pill-btn {% if option.selected_value == value %}selected{% endif %}"
                      data-option-index="{{ option.position }}"
                      data-value="{{ value | escape }}"
                      onclick="selectVariantOption(this, {{ option.position }}, '{{ value | escape }}')"
                      style="padding: 0.5rem 1rem; border-radius: 20px; border: 1.5px solid {% if option.selected_value == value %}#0f172a{% else %}#cbd5e1{% endif %}; background: {% if option.selected_value == value %}#0f172a{% else %}#fff{% endif %}; color: {% if option.selected_value == value %}#fff{% else %}#334155{% endif %}; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}

            <!-- Hidden Shopify Native Variant Select -->
            <select id="product-native-variant-select" style="display: none;">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare-price="{{ variant.compare_at_price }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                  {{ variant.title }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endunless %}

        <!-- Standard Shopify Form for Native Releasit App Hooks -->
        {% form 'product', product, id: 'product-form-pdp', class: 'form product-form', data-type: 'add-to-cart-form', onsubmit: 'if(window.Shopify && window.Shopify.designMode){ event.preventDefault(); return false; }' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="product-variant-id-input">

          <!-- Releasit COD Form App Blocks Support -->
          {% for block in section.blocks %}
            {% case block.type %}
              {% when '@app' %}
                {% render block %}
            {% endcase %}
          {% endfor %}

          <!-- Releasit COD Form Direct Embed Container -->
          <div class="releasit-cod-form" id="releasit-cod-form-container" data-product-id="{{ product.id }}" style="margin: 0.5rem 0 1.25rem;">
            <!-- Releasit COD Form Shopify app automatically renders its form and payment button here -->
          </div>
        {% endform %}

        <!-- Trust Badges Container -->
        {% if section.settings.show_trust_badges %}
          <div class="trust-badges-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; background: #f8fafc; padding: 1.25rem; border-radius: 12px; border: 1px solid #e2e8f0; margin-top: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <span style="font-size: 1.4rem;">🚚</span>
              <div>
                <strong style="display: block; font-size: 0.85rem; color: #0f172a;">{{ section.settings.badge1_title | default: "Envío Gratis" }}</strong>
                <span style="font-size: 0.75rem; color: #64748b;">{{ section.settings.badge1_sub | default: "A todo el Perú sin costo" }}</span>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <span style="font-size: 1.4rem;">🤝</span>
              <div>
                <strong style="display: block; font-size: 0.85rem; color: #0f172a;">{{ section.settings.badge2_title | default: "Pago al Recibir" }}</strong>
                <span style="font-size: 0.75rem; color: #64748b;">{{ section.settings.badge2_sub | default: "Efectivo, Yape o Plin" }}</span>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <span style="font-size: 1.4rem;">🛡️</span>
              <div>
                <strong style="display: block; font-size: 0.85rem; color: #0f172a;">{{ section.settings.badge3_title | default: "Garantía de 30 Días" }}</strong>
                <span style="font-size: 0.75rem; color: #64748b;">{{ section.settings.badge3_sub | default: "Satisfacción 100% asegurada" }}</span>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 0.6rem;">
              <span style="font-size: 1.4rem;">⚡</span>
              <div>
                <strong style="display: block; font-size: 0.85rem; color: #0f172a;">{{ section.settings.badge4_title | default: "Despacho Rápido" }}</strong>
                <span style="font-size: 0.75rem; color: #64748b;">{{ section.settings.badge4_sub | default: "Entrega en 24 a 48 hrs" }}</span>
              </div>
            </div>
          </div>
        {% endif %}

        <!-- Product Detailed Copy Provided by Merchant -->
        <div class="product-full-copy" style="margin-top: 2rem; border-top: 1px solid #e2e8f0; padding-top: 2rem; color: #334155; line-height: 1.7; font-size: 0.95rem;">
          
          <p style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 1.5rem; font-weight: 500;">
            Descubre el poder de una fórmula creada para quienes quieren llevar su rutina de belleza y bienestar al siguiente nivel. <strong>BIOTINA MAX + COLÁGENO – FÓRMULA PREMIUM</strong> combina dos de los ingredientes más reconocidos en el mundo del cuidado personal en un suplemento pensado para complementar tu día a día desde el interior.
          </p>

          <div style="background: #fdf2f8; border-left: 4px solid #ec4899; padding: 1.25rem; border-radius: 8px; margin-bottom: 1.5rem;">
            <h3 style="font-family: var(--font-heading, sans-serif); color: #be185d; font-size: 1.15rem; margin: 0 0 0.5rem; font-weight: 800;">
              💎 BELLEZA QUE EMPIEZA DESDE ADENTRO
            </h3>
            <p style="margin: 0; color: #831843;">
              Una combinación premium de Biotina + Colágeno ideal para acompañar el cuidado de tu cabello, piel y uñas, convirtiéndose en el aliado perfecto de tu rutina diaria de belleza.
            </p>
          </div>

          <h3 style="font-family: var(--font-heading, sans-serif); color: #0f172a; font-size: 1.2rem; font-weight: 800; margin: 1.75rem 0 1rem;">
            ✨ ¿POR QUÉ ELEGIR BIOTINA MAX + COLÁGENO?
          </h3>

          <ul style="list-style: none; padding: 0; margin: 0 0 1.75rem; display: flex; flex-direction: column; gap: 0.85rem;">
            <li style="display: flex; gap: 0.6rem;">
              <span style="color: #2563eb; font-weight: 800;">•</span>
              <div><strong>Fórmula Premium:</strong> una combinación especialmente pensada para quienes buscan algo más que un suplemento convencional.</div>
            </li>
            <li style="display: flex; gap: 0.6rem;">
              <span style="color: #2563eb; font-weight: 800;">•</span>
              <div><strong>Cabello con apariencia más cuidada:</strong> complementa tu rutina para mantener una imagen fuerte, saludable y llena de vitalidad.</div>
            </li>
            <li style="display: flex; gap: 0.6rem;">
              <span style="color: #2563eb; font-weight: 800;">•</span>
              <div><strong>Uñas como protagonistas:</strong> ideal para quienes desean acompañar el mantenimiento de uñas fuertes y bien cuidadas.</div>
            </li>
            <li style="display: flex; gap: 0.6rem;">
              <span style="color: #2563eb; font-weight: 800;">•</span>
              <div><strong>Piel y belleza integral:</strong> el colágeno forma parte natural de la estructura de la piel, mientras que la biotina participa en procesos normales del organismo.</div>
            </li>
            <li style="display: flex; gap: 0.6rem;">
              <span style="color: #2563eb; font-weight: 800;">•</span>
              <div><strong>Belleza 360°:</strong> cabello, piel y uñas en una sola fórmula.</div>
            </li>
            <li style="display: flex; gap: 0.6rem;">
              <span style="color: #2563eb; font-weight: 800;">•</span>
              <div><strong>Fácil de incorporar a tu rutina:</strong> porque cuidarte no debería ser complicado.</div>
            </li>
          </ul>

          <h3 style="font-family: var(--font-heading, sans-serif); color: #0f172a; font-size: 1.2rem; font-weight: 800; margin: 1.75rem 0 1rem;">
            🌟 TU RITUAL DE BELLEZA, AHORA EN VERSIÓN PREMIUM
          </h3>

          <p style="margin-bottom: 1rem;">
            No se trata solamente de verte bien. Se trata de convertir cada día en una oportunidad para invertir en ti, en tu cuidado y en esa confianza que se nota.
          </p>

          <p style="margin-bottom: 1.5rem;">
            <strong>BIOTINA MAX + COLÁGENO</strong> ha sido pensado para mujeres y hombres que buscan complementar un estilo de vida enfocado en el bienestar, el cuidado personal y una imagen impecable.
          </p>

          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem;">
            <h4 style="font-family: var(--font-heading, sans-serif); color: #0f172a; font-size: 1.1rem; font-weight: 800; margin: 0 0 1rem; text-align: center;">
              🔥 DOS GRANDES ALIADOS. UNA SOLA FÓRMULA.
            </h4>

            <div style="margin-bottom: 1rem;">
              <strong style="color: #1e293b; display: block; margin-bottom: 0.25rem;">BIOTINA</strong>
              <p style="margin: 0; font-size: 0.9rem; color: #64748b;">
                Una vitamina ampliamente utilizada en suplementos de belleza y nutrición, relacionada con el mantenimiento normal del cabello y la piel.*
              </p>
            </div>

            <div>
              <strong style="color: #1e293b; display: block; margin-bottom: 0.25rem;">COLÁGENO</strong>
              <p style="margin: 0; font-size: 0.9rem; color: #64748b;">
                Una proteína naturalmente presente en nuestro organismo y uno de los componentes estructurales más importantes de tejidos como la piel.*
              </p>
            </div>
          </div>

          <div style="text-align: center; padding: 1.25rem; background: #eff6ff; border-radius: 12px; margin-bottom: 1.5rem;">
            <p style="font-weight: 800; color: #1e40af; margin: 0 0 0.5rem; font-size: 1.05rem;">
              💖 Haz de tu cuidado personal un hábito, no una excepción.
            </p>
            <p style="margin: 0; color: #1d4ed8; font-size: 0.95rem;">
              Incorpora <strong>BIOTINA MAX + COLÁGENO – FÓRMULA PREMIUM</strong> a tu rutina y dale a tu belleza el protagonismo que merece.
            </p>
          </div>

          <p style="text-align: center; font-weight: 800; font-size: 1.1rem; color: #0f172a; margin-bottom: 1rem;">
            Más cuidado. Más confianza. Más tú.<br>
            <span style="color: #2563eb;">BIOTINA MAX + COLÁGENO</span><br>
            <span style="font-size: 0.9rem; font-weight: 600; color: #64748b;">La combinación premium que tu rutina de belleza estaba esperando.</span>
          </p>

          <p style="font-size: 0.75rem; color: #94a3b8; line-height: 1.5; font-style: italic; margin-top: 1.5rem; border-top: 1px solid #f1f5f9; padding-top: 1rem;">
            * Los suplementos alimenticios no sustituyen una alimentación equilibrada ni un estilo de vida saludable. Las propiedades y declaraciones permitidas pueden variar según la composición exacta del producto y la normativa de cada país.
          </p>

        </div>

      </div>
    </div>
  </div>
</section>

<script>
  function adjustQtyVal(delta) {
    const input = document.getElementById('selected-product-qty');
    if (!input) return;
    const current = parseInt(input.value, 10) || 1;
    const next = Math.max(1, current + delta);
    input.value = next;
  }
  function onQtyInputChange(val) {
    const input = document.getElementById('selected-product-qty');
    if (!input) return;
    const current = parseInt(val, 10) || 1;
    input.value = Math.max(1, current);
  }
</script>

{% schema %}
{
  "name": "Ficha de Producto COD",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Barra de Urgencia y Temporizador"
    },
    {
      "type": "checkbox",
      "id": "show_urgency_bar",
      "label": "Mostrar barra de urgencia",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Texto de urgencia",
      "default": "¡OFERTA ESPECIAL POR TIEMPO LIMITADO!"
    },
    {
      "type": "header",
      "content": "Barra de Stock"
    },
    {
      "type": "checkbox",
      "id": "show_stock_bar",
      "label": "Mostrar indicador de stock",
      "default": true
    },
    {
      "type": "text",
      "id": "stock_text",
      "label": "Texto de alerta de stock",
      "default": "¡ALERTA DE STOCK BAJO!"
    },
    {
      "type": "number",
      "id": "initial_stock",
      "label": "Unidades restantes iniciales",
      "default": 10
    },
    {
      "type": "header",
      "content": "Insignia de Descuento e Info"
    },
    {
      "type": "checkbox",
      "id": "show_discount_badge",
      "label": "Mostrar insignia de descuento sobre imagen",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_badge_text",
      "label": "Texto insignia descuento",
      "default": "🔥 HASTA -30% OFF"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Mostrar marca / proveedor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar estrellas y reseñas",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Texto resumen de opiniones",
      "default": "142 opiniones verificadas"
    },
    {
      "type": "header",
      "content": "Garantías y Badges de Confianza"
    },
