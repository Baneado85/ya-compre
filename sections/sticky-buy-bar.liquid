{% if section.settings.enable_sticky_bar %}
<div 
  id="sticky-cod-buy-bar" 
  class="sticky-buy-bar" 
  style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 999; background: rgba(255,255,255,0.96); backdrop-filter: blur(10px); border-top: 1px solid rgba(0,0,0,0.1); padding: 0.75rem 1rem; box-shadow: 0 -4px 20px rgba(0,0,0,0.1); transform: translateY(100%); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);"
>
  <div class="container" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; max-width: 1200px; margin: 0 auto;">
    
    <!-- Thumbnail & Info -->
    <div style="display: flex; align-items: center; gap: 0.75rem; overflow: hidden;">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0; flex-shrink: 0;">
      {% endif %}
      <div style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
        <div style="font-weight: 800; font-size: 0.9rem; color: #0f172a; overflow: hidden; text-overflow: ellipsis;">
          {{ product.title }}
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="font-weight: 900; font-size: 1rem; color: #16a34a;" id="sticky-bar-price">
            {{ product.selected_or_first_available_variant.price | money }}
          </span>
          {% if product.compare_at_price > product.price %}
            <span style="font-size: 0.8rem; text-decoration: line-through; color: #94a3b8;">
              {{ product.compare_at_price | money }}
            </span>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- CTA Button -->
    <button 
      type="button" 
      onclick="triggerCODOrderProcess()"
      style="padding: 0.75rem 1.5rem; background: {{ section.settings.btn_bg | default: '#16a34a' }}; color: #ffffff; border: none; border-radius: 10px; font-weight: 800; font-size: 0.95rem; font-family: var(--font-heading, sans-serif); text-transform: uppercase; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0; box-shadow: 0 4px 15px rgba(22,163,74,0.3);"
    >
      <span>📦</span>
      <span>{{ section.settings.btn_text | default: "PEDIR AHORA — PAGO AL RECIBIR" }}</span>
    </button>

  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Barra Flotante de Compra",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_bar",
      "label": "Habilitar barra flotante de compra",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Texto del Botón",
      "default": "PEDIR AHORA — PAGO AL RECIBIR"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Color de Fondo del Botón",
      "default": "#16a34a"
    }
  ]
}
{% endschema %}
