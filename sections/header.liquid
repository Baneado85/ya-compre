<header class="site-header" id="site-header">
  <div class="container nav-container">

    <!-- Mobile Menu Toggle Button -->
    <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Abrir menú de navegación">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Brand Logo & Name -->
    <a href="{{ routes.root_url }}" class="brand-logo" id="brand-logo-link">
      <img src="{{ 'logo2.png' | asset_url }}" alt="{{ shop.name }} Logo">
      <span class="brand-name">{{ section.settings.brand_name | default: shop.name }}</span>
    </a>

    <!-- Navigation Links -->
    <nav>
      <ul class="nav-links" id="nav-links">
        <li><a href="#hero" class="active">Inicio</a></li>
        <li><a href="#productos">Productos</a></li>
        <li><a href="#centro-ayuda" onclick="openHelpModal(event)">Centro de ayuda</a></li>
        <li><a href="#sobre-nosotros" onclick="openAboutModal(event)">Sobre nosotros</a></li>
      </ul>
    </nav>

    <!-- Header Action Buttons -->
    <div class="nav-actions">
      <button class="icon-btn" id="search-icon-btn" onclick="openSearchModal()" aria-label="Buscar productos">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>

      <button class="icon-btn" id="cart-icon-btn" aria-label="Ver Carrito de Compras">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-badge" id="cart-count-badge">{{ cart.item_count }}</span>
      </button>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Encabezado",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Nombre de marca mostrado",
      "default": "YA COMPRÉ"
    }
  ]
}
{% endschema %}
