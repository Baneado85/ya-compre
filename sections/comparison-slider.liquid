<section class="comparison-section">
  <div class="container">
    <div class="comparison-wrapper">
      <h2 class="comparison-title">{{ section.settings.title | default: 'Mira la diferencia en calidad' }}</h2>
      <p class="comparison-desc">{{ section.settings.description | default: 'Arrastra el control para comparar la calidad de nuestro producto con opciones convencionales.' }}</p>

      <div class="before-after-container" id="comparison-container">
        <!-- After Image (Bottom) -->
        <img src="{{ 'hero_bg.png' | asset_url }}" alt="Con YA COMPRÉ" class="after-image">
        <span class="comparison-label label-after">CON YA COMPRÉ</span>

        <!-- Before Image (Top Clip) -->
        <div class="before-image-wrapper" id="before-wrapper">
          <img src="{{ 'hero_bg.png' | asset_url }}" alt="Producto Común" class="before-image">
          <span class="comparison-label label-before">OPCIÓN COMÚN</span>
        </div>

        <!-- Drag Handle Button -->
        <div class="slider-handle" id="comparison-handle">
          <div class="slider-handle-button">↔</div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparador antes/después",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Mira la diferencia en calidad" },
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "Arrastra el control para comparar la calidad de nuestro producto con opciones convencionales." }
  ],
  "presets": [
    { "name": "Comparador antes/después" }
  ]
}
{% endschema %}
