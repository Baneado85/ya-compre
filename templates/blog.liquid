<section style="padding: 5rem 0; background-color: var(--bg-dark); color: var(--text-light);">
  <div class="container">
    <h1 class="section-title" style="margin-bottom: 2rem;">{{ blog.title }}</h1>
    <div class="testimonials-grid">
      {% for article in blog.articles %}
        <article class="testimonial-card" style="justify-content: flex-start; gap: 0.75rem;">
          <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <p style="color: #AAA; font-size: 0.85rem;">{{ article.published_at | date: "%d/%m/%Y" }}</p>
          <p style="color: #D6D0C7;">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
