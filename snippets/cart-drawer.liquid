<!-- Slide-out Cart Drawer -->
<div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
<aside class="cart-drawer" id="cart-drawer">
  <div class="cart-drawer-header">
    <h3>Tu Carrito (<span id="cart-drawer-count">{{ cart.item_count }}</span>)</h3>
    <button class="icon-btn" id="close-cart-drawer" aria-label="Cerrar Carrito">&times;</button>
  </div>

  <div style="background: #dcfce7; color: #166534; padding: 0.65rem 1rem; border-radius: 8px; font-weight: 700; font-size: 0.85rem; text-align: center; margin: 0.75rem 1rem 0; border: 1px solid #bbf7d0;">
    🎉 ¡Felicidades! Tienes <strong>ENVÍO GRATIS</strong> a todo el Perú
  </div>

  <div class="cart-items-container" id="cart-items-container">
    <!-- Injected via JavaScript on load -->
  </div>

  <div class="cart-drawer-footer">
    <div class="cart-subtotal-row">
      <span>Subtotal:</span>
      <span id="cart-subtotal-val">{{ cart.total_price | money }}</span>
    </div>
    <p style="font-size: 0.75rem; color: var(--text-muted);">Envío gratis y pago contra entrega al recibir en tu domicilio.</p>
    <button class="cart-checkout-btn" id="cart-checkout-btn" data-releasit-button="true" onclick="triggerCODOrderProcess(event)">
      📦 PAGO CONTRA ENTREGA
    </button>
  </div>
</aside>
